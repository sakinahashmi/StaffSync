# Root StaffSync Environment Configuration Reference
# For Vercel Deployment, configure these variables in Project Settings > Environment Variables

# Backend Environment Variables
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/staffsync?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/staffsync
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRE=30d
CLIENT_URL=https://your-staffsync-app.vercel.app

# Frontend Environment Variables (Optional for single Vercel project deployment; defaults to relative /api)
VITE_API_URL=/api
