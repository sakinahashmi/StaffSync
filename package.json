{
  "name": "staffsync",
  "version": "1.0.0",
  "description": "StaffSync - Modern Human Resource Management System",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "client:build": "npm --prefix client run build",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "seed": "npm --prefix server run seed",
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "keywords": [
    "hrms",
    "staffsync",
    "react",
    "express",
    "mongodb",
    "vite",
    "bootstrap"
  ],
  "author": "StaffSync Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  }
}
